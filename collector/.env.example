# Copy to .env (same folder as config.json). Never commit .env.
# GitHub fine-grained PAT, read-only: Metadata, Contents, Pull requests, Commit statuses, Checks, Actions
GITHUB_TOKEN=github_pat_...
# Jenkins: your user id and an API token (Jenkins -> your name -> Configure -> API Token)
JENKINS_USER=your.name
JENKINS_TOKEN=11...
